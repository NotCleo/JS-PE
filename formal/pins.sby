[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 12

[engines]
smtbmc yices

[script]
read -formal jspe_pins.v
hierarchy -top jspe_pins
proc
cd jspe_pins
rename \g_uo[0].g_pad.c fv_uc0
rename \g_uo[0].g_pad.en fv_ue0
rename \g_uo[1].g_pad.c fv_uc1
rename \g_uo[1].g_pad.en fv_ue1
rename \g_uo[2].g_pad.c fv_uc2
rename \g_uo[2].g_pad.en fv_ue2
rename \g_uo[3].g_pad.c fv_uc3
rename \g_uo[3].g_pad.en fv_ue3
rename \g_uo[6].g_pad.c fv_uc6
rename \g_uo[6].g_pad.en fv_ue6
rename \g_uo[7].g_pad.c fv_uc7
rename \g_uo[7].g_pad.en fv_ue7
rename \g_uio[0].c fv_ic0
rename \g_uio[1].c fv_ic1
rename \g_uio[2].c fv_ic2
rename \g_uio[3].c fv_ic3
rename \g_uio[4].c fv_ic4
rename \g_uio[5].c fv_ic5
rename \g_uio[6].c fv_ic6
rename \g_uio[7].c fv_ic7
cd ..
expose jspe_pins/held jspe_pins/fv_*
prep -top jspe_pins
read -formal -sv fv_pins.v
prep -top fv_pins

[files]
../src/jspe_pins.v
fv_pins.v
