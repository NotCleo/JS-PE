      .fb       (fb),
      .fpar     (fpar),
      .frun     (frun),
      .fw       (fw),
      .loop_end (loop_end),
      .z_n      (z_n),
      .cy_n     (cy_n),
      .flag_we  (flag_we),
      .opb      (opb),
      .wr_en    (wr_en),
      .wr_reg   (wr_reg),
      .wr_data  (wr_data),
      .maddr    (maddr),
      .gnt      (gnt),
      .mem_rdata(mem_rdata),
      .ir       (ir),
      .fire     (fire),
      .ld_done  (ld_done),
      .st_done  (st_done),
      .req      (req),
      .we       (we),
      .addr     (addr),
      .pc       (pc),
      .l        (l),
      .cy       (cy),
      .run      (run),
      .waiting  (waiting),
      .ovr      (ovr),
      .halted   (halted),
      .trap     (trap),
      .xm       (xm),
      .irv      (irv),
      .pfv      (pfv),
      .hrv      (hrv),
      .fl_v     (fl_v),
      .fl_ld    (fl_ld),
      .mo_v     (mo_v),
      .redir    (redir),
      .target   (target),
      .arr_ir   (arr_ir),
      .fp       (fp),
      .hr       (hr),
      .pf       (pf),
      .arr_pf   (arr_pf),
      .f        (f),
      .d        (d),
      .wf       (wf),
      .wabort   (wabort),
      .undef    (undef),
      .cv0      (cv0),
      .cv1      (cv1),
      .wen      (wen),
      .wprev    (wprev),
      .cc0      (cc0),
      .cc1      (cc1),
