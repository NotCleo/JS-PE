  // jspe_seq outputs and the internals exposed by seq.sby (all seq tasks)
  wire [15:0] ir, hr, pf;
  wire        fire, ld_done, st_done, req, we, cy, run, waiting, ovr, halted, trap, xm;
  wire [8:0]  addr, pc, l, target, fp;
  wire        irv, pfv, hrv, fl_v, fl_ld, mo_v, redir, arr_ir, arr_pf, wf, wabort, undef, cv0, cv1;
  wire [9:0]  f, d;
  wire [13:0] cc0, cc1;
  wire [8:0]  wv0, wv1;
  wire [1:0]  wen, wprev;
  wire        stepm, adv, fold;
  wire        f_e, f_jp, f_jf, f_gm, f_rx, is_mem, is_st, is_jmpa, is_call, is_wcfg, is_ret, is_halt, is_ovclr, is_watch, is_txw, is_pull;
  jspe_seq dut (
      .clk      (clk),
      .rst      (rst),
      .run_p    (run_p),
      .stop_p   (stop_p),
      .step_p   (step_p),
      .exec_p   (exec_p),
      .exec_word(exec_word),
